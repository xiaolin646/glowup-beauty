# GlowUp Beauty - AI API Keys Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# DeepSeek Configuration (Recommended - 中国可访问)
# ============================================
# Get your API key from: https://platform.deepseek.com/
VITE_DEEPSEEK_API_KEY=sk-8a17b27025dd4b94ac97f3b689bfc941
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================
# OpenAI Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# Note: 需要代理才能在中国访问
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_ORG_ID=your-org-id  # Optional

# ============================================
# Claude (Anthropic) Configuration
# ============================================
# Get your API key from: https://console.anthropic.com/settings/keys
# Note: Anthropic API在中国可直接访问
VITE_CLAUDE_API_KEY=your-claude-api-key
VITE_CLAUDE_BASE_URL=https://api.anthropic.com/v1

# ============================================
# Google Gemini Configuration
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
# Note: 需要代理才能在中国访问
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ============================================
# Custom AI Provider Configuration
# ============================================
VITE_CUSTOM_AI_API_KEY=your-custom-api-key
VITE_CUSTOM_AI_BASE_URL=https://your-custom-ai-endpoint.com/v1

# ============================================
# General AI Settings
# ============================================
# Request timeout in milliseconds (default: 60000)
VITE_AI_TIMEOUT=60000

# Maximum number of retries (default: 3)
VITE_AI_MAX_RETRIES=3

# Retry delay in milliseconds (default: 1000)
VITE_AI_RETRY_DELAY=1000
